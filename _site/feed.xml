<span class="k">ON</span> <span class="k">C</span><span class="p">.</span><span class="n">CART_ID</span> <span class="o">=</span> <span class="n">M</span><span class="p">.</span><span class="n">CART_ID</span>
<span class="k">WHERE</span> <span class="k">C</span><span class="p">.</span><span class="n">NAME</span> <span class="k">IN</span> <span class="p">(</span><span class="s1">'Yogurt'</span><span class="p">)</span>
<span class="k">GROUP</span> <span class="k">BY</span> <span class="n">CART_ID</span>
<span class="k">ORDER</span> <span class="k">BY</span> <span class="n">CART_ID</span>
